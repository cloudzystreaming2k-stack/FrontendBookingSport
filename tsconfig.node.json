{
   "compilerOptions": {
      "target": "ES2022",
      "lib": [
         "ES2023"
      ],
      "module": "ESNext",
      "skipLibCheck": true,
      /* Bundler mode */
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "isolatedModules": true,
      "moduleDetection": "force",
      "noEmit": true,
      /* Node types for vite.config.ts (__dirname, path, etc.) */
      "types": [
         "node"
      ]
   },
   "include": [
      "vite.config.ts"
   ]
}